{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-ai-starter-kit",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "observability": {
    "enabled": false
  },
  "env": {
    "staging": {
      "name": "cloudflare-ai-starter-kit-staging",
      "routes": [],
      "vars": {
        "APP_ENV": "staging",
        "AI_VERIFICATION_ENABLED": "false",
        "AI_VERIFICATION_START": "",
        "JEV_MODE": "off",
        "APP_ORIGIN": "https://staging.example.invalid",
        "AUTH_MODE": "access",
        "ACCESS_TEAM_DOMAIN": "example-team1.cloudflareaccess.com",
        "ACCESS_AUD": "",
        "LOCAL_DEMO": "false",
        "ENABLE_RAG": "false",
        "ENABLE_AGENT": "false",
        "ENABLE_WORKFLOWS": "false",
        "ENABLE_IMAGES": "false",
        "ENABLE_MEDIA": "false",
        "MEDIA_ALLOWED_MODELS": "[]",
        "ENABLE_BILLING": "false"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cloudflare-ai-starter-kit-staging",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ]
    },
    "production": {
      "name": "cloudflare-ai-starter-kit-production",
      "vars": {
        "APP_ENV": "production",
        "APP_ORIGIN": "https://production.example.invalid",
        "AUTH_MODE": "better-auth",
        "LOCAL_DEMO": "false",
        "AI_MODE": "off",
        "JEV_MODE": "off",
        "ENABLE_RAG": "false",
        "ENABLE_AGENT": "false",
        "ENABLE_WORKFLOWS": "false",
        "ENABLE_IMAGES": "false",
        "ENABLE_MEDIA": "false",
        "MEDIA_ALLOWED_MODELS": "[]",
        "ENABLE_BILLING": "false"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "starter-production",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ]
    }
  },
  "vars": {
    "APP_ENV": "local",
    "APP_ORIGIN": "http://127.0.0.1:3000",
    "AUTH_MODE": "better-auth",
    "LOCAL_DEMO": "true",
    "JEV_MODE": "off",
    "ENABLE_RAG": "false",
    "ENABLE_AGENT": "false",
    "ENABLE_WORKFLOWS": "false",
    "ENABLE_IMAGES": "false",
    "ENABLE_MEDIA": "false",
    "MEDIA_ALLOWED_MODELS": "[]",
    "ENABLE_BILLING": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "starter-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
