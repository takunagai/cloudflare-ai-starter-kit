{
  "name": "cloudflare-ai-starter-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=26.10.0 <27",
    "pnpm": "12.6.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "format": "biome check --write .",
    "lint": "biome check .",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --include-runtime false worker-configuration.d.ts",
    "typecheck": "pnpm cf-typegen && tsr generate && tsc --noEmit",
    "test": "vitest run && pnpm test:build",
    "test:build": "node --test tests/build-fixtures.test.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "smoke": "node scripts/smoke.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.82",
    "@ai-sdk/google": "4.0.99",
    "@ai-sdk/openai": "4.0.96",
    "@ai-sdk/openai-compatible": "3.0.71",
    "@ai-sdk/provider": "4.0.29",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/webp": "1.5.0",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@polar-sh/sdk": "1.0.2",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "ai": "7.0.143",
    "better-auth": "1.7.10",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.12",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "standardwebhooks": "1.1.1",
    "workers-ai-provider": "4.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/vitest-plugin": "1.4.4",
    "@cloudflare/workers-types": "5.20261016.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-cli": "1.167.45",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  }
}
