// 公開断片: 新しい管理外設定のenv.productionへ適用。単独deploy不可。
// production専用Worker/DB。認証Secretとメール設定は本人が別承認後に準備。
{
  "env": {
    "production": {
      "name": "example-public-production",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [],
      "vars": {
        "APP_ENV": "production",
        "APP_ORIGIN": "https://public-production.example.invalid",
        "AUTH_MODE": "better-auth",
        "EMAIL_FROM": "",
        "LOCAL_DEMO": "false",
        "AI_MODE": "off",
        "JEV_MODE": "off",
        "ENABLE_RAG": "false",
        "ENABLE_AGENT": "false",
        "ENABLE_WORKFLOWS": "false",
        "ENABLE_IMAGES": "false",
        "ENABLE_MEDIA": "false",
        "MEDIA_ALLOWED_MODELS": "[]",
        "ENABLE_BILLING": "false"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "example-public-production",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "send_email": [{ "name": "EMAIL" }]
    }
  }
}
